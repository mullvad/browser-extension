{
  "extends": "./.wxt/tsconfig.json",
  "compilerOptions": {
    "module": "ESNext",
    "target": "es2016",
    "lib": ["DOM", "ESNext"],
    "strict": true,
    "esModuleInterop": true,
    "incremental": false,
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "forceConsistentCasingInFileNames": true,
    "types": ["vite/client", "@types/firefox-webext-browser", "vitest/globals", "node"]
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.d.ts",
    "src/**/*.types.ts",
    "src/**/*.test.ts",
    "src/**/*.vue",
    "wxt.config.ts"
  ],
  "exclude": ["node_modules", ".output", ".wxt", "extension", "dist"]
}
